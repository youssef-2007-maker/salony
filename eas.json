{
  "cli": {
    "version": ">= 7.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "SALONY_ENV": "development",
        "SALONY_API_URL": "http://localhost:4000"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "SALONY_ENV": "staging",
        "SALONY_API_URL": "https://staging-api.salony.app",
        "SALONY_PRIVACY_URL": "https://salony.app/privacy",
        "SALONY_TERMS_URL": "https://salony.app/terms",
        "SALONY_SUPPORT_URL": "https://salony.app/support"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "SALONY_ENV": "production",
        "SALONY_API_URL": "https://api.salony.app",
        "SALONY_PRIVACY_URL": "https://salony.app/privacy",
        "SALONY_TERMS_URL": "https://salony.app/terms",
        "SALONY_SUPPORT_URL": "https://salony.app/support",
        "SALONY_SUPPORT_EMAIL": "support@salony.app"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "YOUR_APPLE_ID_EMAIL",
        "ascAppId": "YOUR_ASC_APP_ID",
        "appleTeamId": "YOUR_APPLE_TEAM_ID"
      },
      "android": {
        "serviceAccountKeyPath": "./play-service-account.json",
        "track": "internal"
      }
    }
  }
}
