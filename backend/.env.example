# Salony backend — environment variables.
# Copy to `.env` for local dev (and load with dotenv if you choose), or set
# these directly on your hosting platform (Render env vars, Fly secrets, etc).

# ---- required for production ----

# Strong random string. Anything > 32 chars is fine. Don't ship the dev default.
JWT_SECRET=change-me-to-a-real-secret

# Listen port (Render/Fly/etc. inject this automatically — leave blank locally).
PORT=4000

# ---- AI (optional; the app falls back to templates if nothing is set) ----

# Marketing copy generator. Either provider works; Anthropic is preferred if both
# are present.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Image generation for AI hairstyle try-on. Either provider works; Replicate is
# tried first if both are present.
REPLICATE_API_TOKEN=
REPLICATE_MODEL=stability-ai/stable-diffusion-img2img
# Optional: pin a specific model version hash (see https://replicate.com/...).
REPLICATE_MODEL_VERSION=

# OpenAI image-edit model used by the hairstyle endpoint when REPLICATE is not set.
OPENAI_IMAGE_MODEL=gpt-image-1

# ---- payments (when you flip from mock UI to real) ----

# Pick one of these stacks. The corresponding route files in routes/ get
# rewritten to use the SDK — see RELEASE.md section 2.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

PAYMOB_API_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_ID=
